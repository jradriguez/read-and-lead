{
  "name": "read-and-lead",
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~57.0.22",
    "expo-asset": "~57.0.17",
    "expo-audio": "~57.0.5",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.13.4",
    "@types/react": "~19.2.2",
    "eslint": "^10.10.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test:unit": "tsx --test tests/*.test.ts",
    "test:ui": "jest --runInBand",
    "content:check": "tsx scripts/check-content.ts --release",
    "content:check:draft": "tsx scripts/check-content.ts",
    "repo:check": "tsx scripts/check-repo.ts",
    "publication:check": "tsx scripts/check-repo.ts --publication && gitleaks git --staged --redact",
    "validate:code": "npm run lint && npm run typecheck && npm run test:unit && npm run test:ui && npm run repo:check",
    "validate": "npm run validate:code && npm run content:check",
    "security:check": "npm audit --audit-level=high && gitleaks git --redact && gitleaks dir . --redact",
    "test:native": "maestro test .maestro/smoke.yaml",
    "draft:audio": "tsx scripts/create-draft-audio.ts",
    "format": "prettier --write App.tsx src scripts tests plugins"
  },
  "private": true,
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
